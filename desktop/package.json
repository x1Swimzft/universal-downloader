{
  "name": "universal-downloader",
  "productName": "Universal Downloader",
  "version": "0.9.0",
  "description": "Universal Video and Audio Downloader for Windows 11",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test updater.test.js",
    "verify-release": "node ../scripts/verify-release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.universaldownloader.app",
    "productName": "Universal Downloader",
    "directories": {
      "output": "dist-release"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "installerIcon": "assets/icon.ico",
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Universal Downloader",
      "license": "../LICENSE"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "x1Swimzft",
        "repo": "universal-downloader",
        "releaseType": "release"
      }
    ],
    "compression": "maximum",
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": ["**/*"]
      },
      {
        "from": "backend-engine",
        "to": "backend-engine",
        "filter": ["**/*"]
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": ["**/*"]
      },
      {
        "from": "frontend-out",
        "to": "frontend-out",
        "filter": ["**/*"]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  }
}
